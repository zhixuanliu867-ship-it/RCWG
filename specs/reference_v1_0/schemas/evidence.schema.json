{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "record_id",
    "fields"
  ],
  "properties": {
    "record_id": {
      "type": "string"
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "value",
          "status",
          "evidence"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {},
          "status": {
            "enum": [
              "supported",
              "refuted",
              "unknown"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "document_id",
                "start_char",
                "end_char"
              ],
              "properties": {
                "document_id": {
                  "type": "string"
                },
                "start_char": {
                  "type": "integer",
                  "minimum": 0
                },
                "end_char": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
